datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles Vehicle[]
  bookings Booking[]

  @@map("customers")
  @@index([email])
  @@index([name])
}

model Vehicle {
  id                 String   @id @default(uuid())
  customerId         String   @map("customer_id")
  registrationNumber String   @unique @map("registration_number")
  make               String
  model              String
  year               Int
  vehicleType        String   @map("vehicle_type")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("vehicles")
  @@index([customerId])
  @@index([registrationNumber])
}

model Mechanic {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String
  status        String   @default("AVAILABLE") // AVAILABLE, BUSY, ON_THE_WAY, OFFLINE
  specialty     String
  rating        Float    @default(5.0)
  jobsCompleted Int      @default(0) @map("jobs_completed")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@map("mechanics")
  @@index([status])
  @@index([specialty])
}

model Service {
  id                String   @id @default(uuid())
  name              String
  category          String
  description       String
  basePrice         Float    @map("base_price")
  estimatedDuration String   @map("estimated_duration")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@map("services")
  @@index([category])
}

model Booking {
  id            String   @id @default(uuid())
  bookingNumber String   @unique @map("booking_number")
  customerId    String   @map("customer_id")
  vehicleId     String   @map("vehicle_id")
  serviceId     String   @map("service_id")
  mechanicId    String?  @map("mechanic_id")
  status        String   @default("PENDING") // PENDING, ASSIGNED, MECHANIC_ON_THE_WAY, IN_PROGRESS, COMPLETED, CANCELLED
  amount        Float
  scheduledAt   DateTime @map("scheduled_at")
  address       String
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer      Customer               @relation(fields: [customerId], references: [id])
  vehicle       Vehicle                @relation(fields: [vehicleId], references: [id])
  service       Service                @relation(fields: [serviceId], references: [id])
  mechanic      Mechanic?              @relation(fields: [mechanicId], references: [id])
  statusHistory BookingStatusHistory[]

  @@map("bookings")
  @@index([bookingNumber])
  @@index([status])
  @@index([scheduledAt])
  @@index([customerId])
  @@index([mechanicId])
  @@index([serviceId])
}

model BookingStatusHistory {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  status    String
  note      String?
  changedAt DateTime @default(now()) @map("changed_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_status_history")
  @@index([bookingId])
  @@index([changedAt])
}

model Activity {
  id            String   @id @default(uuid())
  type          String
  title         String
  description   String
  bookingNumber String?  @map("booking_number")
  bookingId     String?  @map("booking_id")
  entityName    String?  @map("entity_name")
  status        String?
  timestamp     DateTime @default(now())

  @@map("activities")
  @@index([timestamp])
}
